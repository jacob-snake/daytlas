# Copy to deploy/.env on the server; never commit it.
SITE_DOMAIN=mebyday.com
RELEASE_TAG=first-preview
# Keep Oura empty for the public sample-data preview.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Public project token only, never a personal/admin API key. Build-time settings.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
