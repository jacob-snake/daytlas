{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mebyday",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mebyday" }],
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_SITE_URL": "https://mebyday.com",
    "OURA_CLIENT_ID": "",
    "OURA_CLIENT_SECRET": "",
    "OURA_REDIRECT_URI": "",
    "MEBYDAY_ACCOUNTS_ENABLED": "false",
    "MEBYDAY_ACCOUNT_PREFERENCES_ENABLED": "false",
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": "",
    "NEXT_PUBLIC_POSTHOG_ENABLED": "false",
    "NEXT_PUBLIC_POSTHOG_KEY": "",
    "NEXT_PUBLIC_POSTHOG_HOST": "https://eu.i.posthog.com",
  },
  "routes": [
    { "pattern": "mebyday.com", "custom_domain": true },
    { "pattern": "www.mebyday.com", "custom_domain": true },
  ],
}
