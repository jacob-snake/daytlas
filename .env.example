# Register an Oura OAuth application and copy its credentials here.
# Keep these server-only: do not prefix them with NEXT_PUBLIC_.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Must match the redirect URI registered with Oura exactly.
# Use your HTTPS origin in production, e.g. https://example.com/api/auth/callback.
# Local setup: npm run dev -- --port 3001
OURA_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Public origin used in social preview metadata (set to your HTTPS URL on deploy).
PUBLIC_SITE_URL=http://localhost:3001
# Production: https://mebyday.com. Legacy WOURA_PUBLIC_URL is accepted as a fallback.

# Optional EU-only website/demo telemetry. Public project token, NOT a personal API key.
# No traffic until configured, enabled AND visitor consent. Connected Oura is excluded.
# Before enabling: confirm project "Discard client IP data", no GeoIP enrichment,
# processor/DPA and raw-event retention policy. Defaults keep analytics inactive.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional independent email account, disabled until the operator completes setup.
# Server-only publishable key; never use a service_role or sb_secret_ key here.
MEBYDAY_ACCOUNTS_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Enable only after deploying/reviewing deploy/supabase/001-account-profiles.sql.
MEBYDAY_ACCOUNT_PREFERENCES_ENABLED=false
